{
  "cli": {
    "version": ">= 24.8.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "node": "24.19.0",
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "node": "24.19.0",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "ORG_GRADLE_PROJECT_reactNativeArchitectures": "arm64-v8a"
      }
    },
    "ios-simulator": {
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    },
    "production": {
      "node": "24.19.0",
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {}
  }
}
